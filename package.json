{
  "publisher": "BhumikJain",
  "name": "push-guard",
  "displayName": "Push Guard",
  "description": "Guards against losing code by reminding users to push before closing VS Code",
  "version": "0.0.1",
  "icon": "images/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.git"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BhumikJain/Push-Guard.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "github-push-reminder.checkGitStatus",
        "title": "Check Git Status and Push to GitHub"
      },
      {
        "command": "github-push-reminder.beforeClose",
        "title": "Check Git Status Before Closing"
      }
    ],
    "keybindings": [
      {
        "command": "github-push-reminder.beforeClose",
        "key": "alt+f4",
        "win": "alt+f4",
        "mac": "cmd+q",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "GitHub Push Reminder",
      "properties": {
        "github-push-reminder.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check for unpushed changes when saving files (helps detect when VS Code is closing)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.4",
    "@vscode/test-electron": "^2.2.0"
  }
}