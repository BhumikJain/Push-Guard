{
  "publisher": "BhumikJain",
  "name": "push-guard",
  "displayName": "Push Guard",
  "description": "Guards against losing code by tracking changes and reminding users to commit and push to Git",
  "version": "0.0.3",
  "icon": "images/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.git"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BhumikJain/Push-Guard.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Push Guard",
      "properties": {
        "pushGuard.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Push Guard for this workspace."
        },
        "pushGuard.linesThreshold": {
          "type": "number",
          "default": 30,
          "description": "Number of lines changed to enable notifications."
        },
        "pushGuard.notificationInterval": {
          "type": "number",
          "default": 15,
          "description": "Interval in minutes for periodic notifications."
        },
        "pushGuard.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check for unpushed changes when saving files."
        },
        "pushGuard.checkOnSaveInterval": {
          "type": "number",
          "default": 5,
          "description": "Minimum interval in minutes between save-triggered checks to prevent notification spam with auto-save."
        }
      }
    },
    "commands": [
      {
        "command": "push-guard.disable",
        "title": "Push Guard: Disable"
      },
      {
        "command": "push-guard.enable",
        "title": "Push Guard: Enable"
      },
      {
        "command": "push-guard.resetCounter",
        "title": "Push Guard: Reset Counter"
      },
      {
        "command": "push-guard.showStats",
        "title": "Push Guard: Show Stats"
      },
      {
        "command": "push-guard.commitAndPush",
        "title": "Push Guard: Commit and Push"
      },
      {
        "command": "push-guard.beforeClose",
        "title": "Push Guard: Check Before Closing"
      }
    ],
    "keybindings": [
      {
        "command": "push-guard.beforeClose",
        "key": "alt+f4",
        "win": "alt+f4",
        "mac": "cmd+q",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.4",
    "@vscode/test-electron": "^2.2.0"
  }
}