{
  "name": "git-push-reminder",
  "displayName": "Git Push Reminder",
  "description": "Reminds users to push code before closing VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BhumikJain/Push-Guard.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-push-reminder.disable",
        "title": "Disable Git Push Reminder"
      },
      {
        "command": "git-push-reminder.enable",
        "title": "Enable Git Push Reminder"
      }
    ],
    "configuration": {
      "title": "Git Push Reminder",
      "properties": {
        "gitPushReminder.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable git push reminders"
        },
        "gitPushReminder.checkInterval": {
          "type": "number",
          "default": 30,
          "description": "How often to check for uncommitted changes (in seconds)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.4",
    "@vscode/test-electron": "^2.2.0"
  }
}